# ── Flask environment ─────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1

# ── Server ────────────────────────────────────────────────────────────────────
PORT=10000

# ── GitHub API token (optional, but recommended) ──────────────────────────────
# Unauthenticated requests: 60/hour. Authenticated: 5000/hour.
# Create one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# ── CORS Origins ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, or * for all [Default: *]
FRONTEND_ORIGINS=*,https://aiagents-frontend.vercel.app,https://aiagents-frontend-bankp27hv-abhiiiiiiiiii.vercel.app,http://localhost:5500

# ── Gemini AI API (Reserved for Phase 2) ────────────────────────────────────────
# Optional Gemini API key. Not required or invoked during Phase 1 foundation.
GEMINI_API_KEY=

# ── Caching & Performance ───────────────────────────────────────────────────────
# In-memory / cache TTL in seconds for repository responses [Default: 300]
CACHE_TTL_SECONDS=300

# ── Logging level ─────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
