# ── Flask environment ─────────────────────────────────────────────────────────
FLASK_ENV=development

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── GitHub API token (optional, but recommended) ──────────────────────────────
# Unauthenticated requests: 60/hour. Authenticated: 5000/hour.
# Create one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# ── CORS — allowed frontend origins (comma-separated) ────────────────────────
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# ── Cache TTL (seconds) — for future caching layer ────────────────────────────
CACHE_TTL_SECONDS=300

# ── Logging level ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Production notes ──────────────────────────────────────────────────────────
# Set FLASK_ENV=production and use Gunicorn:
#   gunicorn --bind 0.0.0.0:$PORT wsgi:app
# Never commit a populated .env file to version control.
