# GitStory Backend Environment Configuration Example
# Copy this file to .env for local development:
#   cp .env.example .env

# ── Flask Configuration ─────────────────────────────────────────────────────────
# Enable debug mode (1 = enabled, 0 = disabled) [Default: 1]
FLASK_DEBUG=1

# Application environment: development | production | testing [Default: development]
FLASK_ENV=development

# Server port [Default: 5000]
PORT=5000

# ── GitHub REST API ─────────────────────────────────────────────────────────────
# Optional personal access token (classic or fine-grained).
# Without token: rate limit is 60 requests/hour.
# With token: rate limit is 5,000 requests/hour.
# Leave blank for local unauthenticated exploration.
GITHUB_TOKEN=

# ── CORS Origins ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins [Required for web requests]
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# ── Gemini AI API (Reserved for Phase 2) ────────────────────────────────────────
# Optional Gemini API key. Not required or invoked during Phase 1 foundation.
GEMINI_API_KEY=

# ── Caching & Performance ───────────────────────────────────────────────────────
# In-memory / cache TTL in seconds for repository responses [Default: 300]
CACHE_TTL_SECONDS=300

# ── Logging ─────────────────────────────────────────────────────────────────────
# Python logging level: DEBUG | INFO | WARNING | ERROR [Default: INFO]
LOG_LEVEL=INFO
