# ── Flask environment ─────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── GitHub API token (optional, but recommended) ──────────────────────────────
# Unauthenticated requests: 60/hour. Authenticated: 5000/hour.
# Create one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# ── CORS Origins ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins [Required for web requests]
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# ── Gemini AI API (Reserved for Phase 2) ────────────────────────────────────────
# Optional Gemini API key. Not required or invoked during Phase 1 foundation.
GEMINI_API_KEY=

# ── Caching & Performance ───────────────────────────────────────────────────────
# In-memory / cache TTL in seconds for repository responses [Default: 300]
CACHE_TTL_SECONDS=300

# ── Logging level ─────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
